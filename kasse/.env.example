# Kopie dieser Datei als ".env" anlegen und anpassen.

# Port und Adresse des Servers
PORT=3000
HOST=0.0.0.0

# Ordner fuer Datenbank und hochgeladene Belege (im Docker-Betrieb /daten)
DATA_DIR=./data

# Hinter einem Reverse Proxy (nginx, Caddy) mit HTTPS:
TRUST_PROXY=true
COOKIE_SECURE=true

# Groesse pro hochgeladenem Foto
MAX_UPLOAD_MB=20

# Erstes Administratorkonto - wird nur beim allerersten Start angelegt.
# Ohne ADMIN_PASSWORT erzeugt der Server eines und zeigt es im Log an.
ADMIN_NAME=Abteilungsleitung
ADMIN_EMAIL=al@cevimarch.ch
# ADMIN_PASSWORT=

NODE_ENV=production
