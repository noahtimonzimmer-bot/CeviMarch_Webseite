# Kopie dieser Datei als ".env" anlegen und anpassen.

# Port und Adresse des Servers
PORT=3000
HOST=0.0.0.0

# Ordner fuer Datenbank und hochgeladene Belege (im Docker-Betrieb /daten)
DATA_DIR=./data

# Hinter einem Reverse Proxy (nginx, Caddy) mit HTTPS:
TRUST_PROXY=true
COOKIE_SECURE=true

# Groesse pro hochgeladenem Foto
MAX_UPLOAD_MB=20

# Die beiden Passwoerter - wirken nur beim allerersten Start.
# Ohne Angabe erzeugt der Server welche und zeigt sie im Log an.
# Spaeter aendert man sie in der App unter "Einstellungen".
# PASSWORT_LEITUNG=
# PASSWORT_MITARBEIT=

NODE_ENV=production
