# =====================================================================
#  nginx - Website und Kassen-App
# =====================================================================
#  Nach /etc/nginx/sites-available/cevimarch kopieren und verlinken.
#  Die HTTPS-Teile ergaenzt certbot selbst, siehe server/https.sh.
#
#  Die Kasse laeuft unter cevimarch.ch/kasse/ - es braucht also keinen
#  eigenen DNS-Eintrag und kein eigenes Zertifikat.
# =====================================================================

server {
    listen 80;
    listen [::]:80;
    # Die IP steht mit dabei, solange die DNS noch nicht umgestellt ist -
    # so laesst sich die Seite vorher anschauen.
    server_name cevimarch.ch www.cevimarch.ch 179.237.123.224;

    root /opt/cevimarch;
    index index.html;

    # Version von nginx nicht verraten
    server_tokens off;

    # Fehlerseite der Seite selbst
    error_page 404 /404.html;

    # ---- Schutzangaben fuer den Browser ------------------------------
    # Stehen in server/schutz.conf, damit sie in jedem location-Block
    # gleich lauten.
    include /etc/nginx/snippets/cevimarch-schutz.conf;

    # ---- Kassen-App unter /kasse/ ------------------------------------
    location ^~ /kasse/ {
        # Belege sind Handyfotos und entsprechend gross
        client_max_body_size 25m;

        proxy_pass         http://127.0.0.1:3000/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-Prefix /kasse;
        proxy_read_timeout 120s;
    }
    location = /kasse { return 301 /kasse/; }
    # Auch mit grossem K landet man an der richtigen Stelle
    location ~* ^/kasse(/.*)?$ { return 301 /kasse$1; }
    # Die Oberflaeche ruft ihre Schnittstelle unter /api auf - die Seite
    # selbst hat dort nichts, also geht alles davon an die App.
    location ^~ /api/ {
        client_max_body_size 25m;
        proxy_pass         http://127.0.0.1:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # ---- Zwischenspeicher --------------------------------------------
    # Die erzeugten Seiten duerfen nicht lange im Cache liegen, die Bilder
    # und Schriften schon - die aendern sich praktisch nie.
    #
    # Achtung: sobald in einem location-Block ein add_header steht, fallen
    # alle von oben geerbten Angaben weg. Darum stehen die Schutzangaben
    # hier noch einmal.
    location ~* \.html$ {
        add_header Cache-Control "no-cache, must-revalidate";
        include /etc/nginx/snippets/cevimarch-schutz.conf;
    }
    location ~* \.(jpg|jpeg|png|webp|svg|woff2|pdf|ico)$ {
        add_header Cache-Control "public, max-age=2592000";
        include /etc/nginx/snippets/cevimarch-schutz.conf;
        access_log off;
    }

    # ---- Interna nicht ausliefern ------------------------------------
    location ~ ^/(\.git|tools|content|server|kasse|scrape)/ { return 404; }
    # Punktdateien sperren, aber die Pruefung von Let's Encrypt zulassen
    location ~ /\.(?!well-known)                             { return 404; }
    location = /CNAME                                       { return 404; }
    # Entwicklungsunterlagen gehoeren nicht ins Netz
    location ~* \.(md|py|sh|yml|yaml|json|lock|nginx)$       { return 404; }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}

# ---- Alles, was unter anderem Namen hereinkommt, abweisen ------------
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    server_tokens off;
    return 444;
}
